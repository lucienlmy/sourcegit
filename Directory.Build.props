<?xml version="1.0" encoding="utf-8"?>
<!--
  统一构建后部署文件到「sourcegit\output\」文件夹
  让 BuildManager.exe 和 SourceGit.exe 最终落在同一目录，可共享 data 文件夹和 %APPDATA%\SourceGit 配置
  自动应用到本目录及子目录下所有 .csproj（向上递归查找）
  不使用 sourcegit\build\，因为 sourcegit 已有 build/scripts 等构建脚本/资源目录放里面，避免覆盖冲突

  作用范围：
    - SourceGit.csproj 在 sourcegit\src\ 下，向上查找经过 src\ → sourcegit\，找到本文件
    - BuildManager.csproj 在 sourcegit\项目构建管理器\BuildManager\ 下，向上查找经过 BuildManager\ → 项目构建管理器\ → sourcegit\，找到本文件
    - AvaloniaEdit/AvaloniaEdit.TextMate 等子项目也能找到本文件，但用 Condition 限定只对主项目生效
-->
<Project>

  <PropertyGroup>
    <!-- 统一部署目录：sourcegit 下的 output 子目录（与本文件同级的 output 子目录），避开已存在的 build/ 脚本目录 -->
    <UnifiedBuildOutputPath>$(MSBuildThisFileDirectory)output\</UnifiedBuildOutputPath>

    <!-- 只生成 Windows x64 平台的运行时文件，过滤其他平台的 runtimes 目录 -->
    <!-- 用 Condition 限定只对 SourceGit 和 BuildManager 主项目生效，避免 AvaloniaEdit 等依赖项目也被注入 RID -->
    <!-- 用 Condition 允许命令行 -r 覆盖（如 -r win-arm64 测试） -->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' AND ('$(MSBuildProjectName)' == 'SourceGit' OR '$(MSBuildProjectName)' == 'BuildManager')">win-x64</RuntimeIdentifier>
    <RuntimeIdentifiers Condition="'$(MSBuildProjectName)' == 'SourceGit' OR '$(MSBuildProjectName)' == 'BuildManager'">win-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <!--
    统一把主项目输出集中到 UnifiedBuildOutputPath（sourcegit\output\）。
    ⚠ Debug 构建 / Debug 发布：不移动 / 不复制，保持 bin\Debug / PublishDir 原样，方便 VS/Rider F5 直接调试。
    ⚠ Release 构建（dotnet build -c Release / VS Release F5）：
       把 $(TargetDir) 下所有文件 Move 到 output\（Build 模式下没有 PublishDir，所以直接搬 TargetDir）。
    ⚠ Release 发布（dotnet publish -c Release）：
       这里 **Build 阶段的 Move 不跑**（因为 Publish 流程需要先把 TargetDir 的文件交给 Publish target 生成
       $(PublishDir) 最终产物），只在 Publish 全部完成之后，一次性 Move $(PublishDir) 到 output\。
       这样避免 Build 先把 TargetDir 搬空，导致 Publish 拿不到文件报错。
  -->
  <Target Name="CopyToUnifiedBuildFolder"
          AfterTargets="Build"
          Condition="'$(AssemblyName)' == 'SourceGit' OR '$(AssemblyName)' == 'BuildManager'">

    <ItemGroup>
      <UnifiedOutputFiles Include="$(TargetDir)**\*.*" />
    </ItemGroup>

    <ItemGroup>
      <_UnifiedDestFiles Include="@(UnifiedOutputFiles->'$(UnifiedBuildOutputPath)%(RecursiveDir)%(Filename)%(Extension)')" />
    </ItemGroup>

    <!-- Debug Build：啥也不做 -->
    <Message Text="🔧 Debug 构建：保持输出在 $(TargetDir)，不移动到 $(UnifiedBuildOutputPath)（方便 F5 调试）"
             Condition="'$(Configuration)' == 'Debug'"
             Importance="high" />

    <!--
      Release Build：只有"真的在跑发布流程"时才跳过 Build 阶段的 Move。
      ⚠ 注意：不能用 $(PublishDir) 是否存在判断！因为我们强制了 RuntimeIdentifier=win-x64，
         .NET SDK 会在 **任何 Build 场景**都把 PublishDir 默认设为 bin\...\publish\（一个路径占位属性），
         结果就是你日志里看到的：
           🚦 Release Build 检测到 Publish 场景（PublishDir=bin\Release\net10.0\win-x64\publish\）
         但那实际上只是纯 Build，根本没跑 Publish target → Move 被误跳过。
      ✅ 正确的「真的在 Publish」信号（SDK 内置）：
         - $(IsPublish) = true            dotnet publish 内部会设这个属性
         - $(DeployOnBuild) = true        VS 发布向导 / CI 的 MSBuild /t:Build /p:DeployOnBuild=true
         - $(PublishProfileName) 非空     VS 用 .pubxml 发布配置
         三者任一命中 → 才判定 Publish 场景，Build 阶段不 Move。
    -->
    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
      <_IsPublishing>false</_IsPublishing>
      <_IsPublishing Condition="'$(IsPublish)' == 'true' OR '$(DeployOnBuild)' == 'true' OR '$(PublishProfileName)' != ''">true</_IsPublishing>
    </PropertyGroup>

    <Message Text="🚦 Release Build：检测到 Publish 流程（IsPublish=$(IsPublish) DeployOnBuild=$(DeployOnBuild) PublishProfileName=$(PublishProfileName)）。保留 $(TargetDir) 文件给 Publish target 稍后使用，Build 阶段不移动"
             Condition="'$(Configuration)' == 'Release' AND '$(_IsPublishing)' == 'true'"
             Importance="high" />

    <!-- 关闭可能锁定 output 文件的进程（SourceGit/BuildManager），确保移动操作成功 -->
    <Message Text="🔧 检测并关闭可能锁定 output 的进程..."
             Condition="'$(Configuration)' == 'Release' AND '$(_IsPublishing)' != 'true'"
             Importance="high" />
    <Message Text="⚠️ 正在编译 BuildManager 自身，将自动关闭 BuildManager 进程以释放文件锁，编译完成后需手动重启"
             Condition="'$(Configuration)' == 'Release' AND '$(_IsPublishing)' != 'true' AND '$(AssemblyName)' == 'BuildManager'"
             Importance="high" />
    <Message Text="⚠️ 正在编译 SourceGit，将自动关闭 SourceGit 进程以释放文件锁"
             Condition="'$(Configuration)' == 'Release' AND '$(_IsPublishing)' != 'true' AND '$(AssemblyName)' == 'SourceGit'"
             Importance="high" />
    <Exec Command="powershell -NoProfile -Command &quot;$procs = Get-Process SourceGit,BuildManager -ErrorAction SilentlyContinue; if ($procs) { $procs | ForEach-Object { Write-Host ('   关闭进程: ' + $_.ProcessName + ' (PID=' + $_.Id + ')'); Stop-Process -Id $_.Id -Force }; Start-Sleep -Milliseconds 500; Write-Host '   进程已关闭，文件锁已释放' } else { Write-Host '   无锁定进程，跳过' }&quot;"
          IgnoreExitCode="true"
          ConsoleToMSBuild="true"
          StandardOutputImportance="high"
          Condition="'$(Configuration)' == 'Release' AND '$(_IsPublishing)' != 'true'" />

    <Delete Files="@(_UnifiedDestFiles)"
            Condition="'$(Configuration)' == 'Release' AND '$(_IsPublishing)' != 'true' AND Exists('%(FullPath)')" />
    <Move SourceFiles="@(UnifiedOutputFiles)"
          DestinationFolder="$(UnifiedBuildOutputPath)%(RecursiveDir)"
          Condition="'$(Configuration)' == 'Release' AND '$(_IsPublishing)' != 'true'" />
    <!-- 清理移动后留下的空目录，向上延伸到 bin\ 但不跨越 -->
    <Exec Command="powershell -NoProfile -Command &quot;$d = '$(TargetDir)'; if (Test-Path $d) { Get-ChildItem $d -Recurse -Directory | Sort-Object { $_.FullName.Length } -Descending | ForEach-Object { if ((Get-ChildItem $_.FullName -Force).Count -eq 0) { Remove-Item $_.FullName -Force; Write-Host ('   清理空目录: ' + $_.FullName) } }; if ((Get-ChildItem $d -Force).Count -eq 0) { Remove-Item $d -Force; Write-Host ('   清理空目录: ' + $d) }; $cur = Split-Path $d -Parent; while ($cur) { $name = Split-Path $cur -Leaf; if ($name -notmatch '^(net\d+\.\d+|net\d+|Debug|Release|win-.*|linux-.*|osx-.*|arm.*|x64|x86)$') { break }; if (-not (Test-Path $cur)) { $cur = Split-Path $cur -Parent; continue }; $cnt = (Get-ChildItem $cur -Force -ErrorAction SilentlyContinue).Count; if ($cnt -eq 0) { Remove-Item $cur -Force; Write-Host ('   清理空目录: ' + $cur) } else { break }; $cur = Split-Path $cur -Parent } }&quot;"
          IgnoreExitCode="true"
          ConsoleToMSBuild="true"
          StandardOutputImportance="high"
          Condition="'$(Configuration)' == 'Release' AND '$(_IsPublishing)' != 'true'" />
    <Message Text="📦 Release 构建：已把 $(AssemblyName) 从 $(TargetDir) 移动到 $(UnifiedBuildOutputPath)"
             Condition="'$(Configuration)' == 'Release' AND '$(_IsPublishing)' != 'true'"
             Importance="high" />
  </Target>

  <!--
    Release Publish 场景：SDK 的 Publish target 自己会把最终发布产物写进 $(PublishDir)
    （我们的项目强制 RuntimeIdentifier=win-x64，所以 PublishDir 就是 TargetDir\publish\）。
    ✅ Publish target 已跑完 → 再 Move $(PublishDir) → UnifiedBuildOutputPath：
       对 dotnet publish 的"是否发布成功"不会产生任何影响，只是把产物搬运到你最终要部署的地方。
    👉 这一步 + 上面 Build 阶段的互斥判断，保证：
       - dotnet build -c Release  → 走第一个 Target：Move TargetDir → output\
       - dotnet publish -c Release → 走第二个 Target：Move PublishDir → output\（Build 阶段不动）
  -->
  <Target Name="CopyToUnifiedBuildPublishFolder"
          AfterTargets="Publish"
          Condition="'$(AssemblyName)' == 'SourceGit' OR '$(AssemblyName)' == 'BuildManager'">

    <ItemGroup>
      <UnifiedPublishFiles Include="$(PublishDir)**\*.*" />
    </ItemGroup>

    <ItemGroup>
      <_UnifiedPublishDestFiles Include="@(UnifiedPublishFiles->'$(UnifiedBuildOutputPath)%(RecursiveDir)%(Filename)%(Extension)')" />
    </ItemGroup>

    <!-- Debug Publish：仍不移动（保持 PublishDir 原样） -->
    <Message Text="🔧 Debug Publish：保持发布输出在 $(PublishDir)，不移动到 $(UnifiedBuildOutputPath)"
             Condition="'$(Configuration)' == 'Debug'"
             Importance="high" />

    <!-- Release Publish：把整个 PublishDir 移动到 output\ -->
    <!-- 先关闭可能锁定文件的进程 -->
    <Message Text="🔧 检测并关闭可能锁定 output 的进程..."
             Condition="'$(Configuration)' == 'Release'"
             Importance="high" />
    <Message Text="⚠️ 正在发布 BuildManager，将自动关闭 BuildManager 进程以释放文件锁"
             Condition="'$(Configuration)' == 'Release' AND '$(AssemblyName)' == 'BuildManager'"
             Importance="high" />
    <Message Text="⚠️ 正在发布 SourceGit，将自动关闭 SourceGit 进程以释放文件锁"
             Condition="'$(Configuration)' == 'Release' AND '$(AssemblyName)' == 'SourceGit'"
             Importance="high" />
    <Exec Command="powershell -NoProfile -Command &quot;$procs = Get-Process SourceGit,BuildManager -ErrorAction SilentlyContinue; if ($procs) { $procs | ForEach-Object { Write-Host ('   关闭进程: ' + $_.ProcessName + ' (PID=' + $_.Id + ')'); Stop-Process -Id $_.Id -Force }; Start-Sleep -Milliseconds 500; Write-Host '   进程已关闭，文件锁已释放' } else { Write-Host '   无锁定进程，跳过' }&quot;"
          IgnoreExitCode="true"
          ConsoleToMSBuild="true"
          StandardOutputImportance="high"
          Condition="'$(Configuration)' == 'Release'" />

    <Delete Files="@(_UnifiedPublishDestFiles)" Condition="'$(Configuration)' == 'Release' AND Exists('%(FullPath)')" />
    <Move SourceFiles="@(UnifiedPublishFiles)"
          DestinationFolder="$(UnifiedBuildOutputPath)%(RecursiveDir)"
          Condition="'$(Configuration)' == 'Release'" />
    <!-- 清理移动后留下的空目录，向上延伸到 bin\ 但不跨越 -->
    <Exec Command="powershell -NoProfile -Command &quot;$d = '$(PublishDir)'; if (Test-Path $d) { Get-ChildItem $d -Recurse -Directory | Sort-Object { $_.FullName.Length } -Descending | ForEach-Object { if ((Get-ChildItem $_.FullName -Force).Count -eq 0) { Remove-Item $_.FullName -Force; Write-Host ('   清理空目录: ' + $_.FullName) } }; if ((Get-ChildItem $d -Force).Count -eq 0) { Remove-Item $d -Force; Write-Host ('   清理空目录: ' + $d) }; $cur = Split-Path $d -Parent; while ($cur) { $name = Split-Path $cur -Leaf; if ($name -notmatch '^(net\d+\.\d+|net\d+|Debug|Release|win-.*|linux-.*|osx-.*|arm.*|x64|x86)$') { break }; if (-not (Test-Path $cur)) { $cur = Split-Path $cur -Parent; continue }; $cnt = (Get-ChildItem $cur -Force -ErrorAction SilentlyContinue).Count; if ($cnt -eq 0) { Remove-Item $cur -Force; Write-Host ('   清理空目录: ' + $cur) } else { break }; $cur = Split-Path $cur -Parent } }&quot;"
          IgnoreExitCode="true"
          ConsoleToMSBuild="true"
          StandardOutputImportance="high"
          Condition="'$(Configuration)' == 'Release'" />
    <Message Text="📦 Release Publish：已把 $(AssemblyName) 从 $(PublishDir) 移动到 $(UnifiedBuildOutputPath)（可直接发布）"
             Condition="'$(Configuration)' == 'Release'"
             Importance="high" />
  </Target>

</Project>
